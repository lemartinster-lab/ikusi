{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ikusi",
  "version": "0.1.0",
  "identifier": "com.lemartinster.ikusi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ikusi",
        "width": 1100,
        "height": 680,
        "minWidth": 520,
        "minHeight": 340,
        "backgroundColor": "#0b0b0d",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; media-src 'self' http://127.0.0.1:* blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Video",
    "shortDescription": "Reproductor multimedia personal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "mkv",
          "mp4",
          "m4v",
          "mov",
          "avi",
          "webm",
          "ts",
          "m2ts",
          "mts",
          "wmv",
          "flv",
          "mpg",
          "mpeg",
          "3gp",
          "ogv"
        ],
        "name": "Vídeo",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "flac",
          "wav",
          "aac",
          "ogg",
          "opus",
          "wma"
        ],
        "name": "Audio",
        "role": "Viewer"
      }
    ]
  }
}
